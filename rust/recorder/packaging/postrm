#!/bin/sh
set -e

TARGET_USER="${SESSION_RECORDER_USER:-pi}"

case "$1" in
  remove|purge)
    if id "$TARGET_USER" >/dev/null 2>&1; then
      runuser -l "$TARGET_USER" -c 'XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user daemon-reload' || true
    fi
    ;;
esac

# Purge intentionally does not run `loginctl disable-linger`: linger is a
# property of the login user's session, not of this package, and other
# services (or the user's own login) may still depend on it.

exit 0
