#!/bin/sh
set -e

TARGET_USER="${SESSION_RECORDER_USER:-pi}"

case "$1" in
  remove|deconfigure)
    if id "$TARGET_USER" >/dev/null 2>&1; then
      runuser -l "$TARGET_USER" -c 'XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user stop session-recorder-alsa-reader.service' || true
      runuser -l "$TARGET_USER" -c 'XDG_RUNTIME_DIR=/run/user/$(id -u) systemctl --user disable session-recorder-alsa-reader.service' || true
    fi
    ;;
esac

exit 0
