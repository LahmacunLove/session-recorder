[Unit]
Description=Session Recorder ALSA reader (captures audio, ChunkSink protocol client)
Documentation=https://github.com/pascalhuerst/session-recorder
Wants=network-online.target avahi-daemon.service pipewire.service wireplumber.service
After=network-online.target avahi-daemon.service pipewire.service wireplumber.service

[Service]
Type=simple
# RECORDER_ARGS (set in the env file) is appended to the command line and must
# at least provide --recorder-id and --recorder-name.
EnvironmentFile=/etc/default/session-recorder-alsa-reader
ExecStart=/usr/bin/session-recorder-alsa-reader $RECORDER_ARGS
Restart=on-failure
RestartSec=5

# This is a systemd --user unit (installed under usr/lib/systemd/user/), not a
# system service: it must run as the same login user whose session hosts
# PipeWire/WirePlumber, since PipeWire's socket access control is UID-scoped —
# a different user (even with matching Unix group membership) is rejected. See
# postinst, which enables linger for that user so this unit also starts
# headless, without an interactive login. For the optional cut button
# (--input-event), that user needs `input` group membership directly, e.g.
# `sudo usermod -aG input <user>`.
#
# NOTE on LEDs: writing /sys/class/leds/<led>/brightness needs either running
# as root (not possible for a user unit) or a udev rule granting the running
# user's group write access. Install such a rule if you use --led-*.

[Install]
WantedBy=default.target
